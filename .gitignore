# Virtual environment
venv/
.venv/

# Python and Jupyter
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Local data: never versioned (see "Getting the data" in the README)
data/

# Secrets: the connection string to the database
.env

# Airflow (local, to learn): its own environment and the files it generates.
# Only the DAGs and the start script are versioned.
.venv-airflow/
airflow/*
!airflow/dags/
!airflow/start.sh
!airflow/tests/
