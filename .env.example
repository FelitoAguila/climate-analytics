# Copy this file to .env and paste your Neon connection string (direct, without -pooler).
# .env holds your password: it is ignored by git, never commit or share it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: read-only user, to share with the team and for the web app (see the README).
READONLY_DATABASE_URL=postgresql://climate_reader:password@host/dbname?sslmode=require
