# Copy this file to .env for local development and paste the read-only Neon URL.
# .env stores the password: it is ignored by git, never commit or share it.
# In production (for example Render), set these variables in the platform instead.
READONLY_DATABASE_URL=postgresql://climate_reader:password@host/dbname?sslmode=require

# Optional local overrides
HOST=0.0.0.0
PORT=8050
DASH_DEBUG=true

# Database pool and timeouts (defaults shown; usually leave unset)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=15000
